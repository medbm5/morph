{
  "ci": {
    "collect": {
      "staticDistDir": "./docs",
      "url": ["http://localhost/index.html"],
      "numberOfRuns": 1,
      "settings": { "onlyCategories": ["accessibility", "best-practices", "seo"], "chromeFlags": "--no-sandbox --headless=new" }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": "./target/lighthouse" }
  }
}
